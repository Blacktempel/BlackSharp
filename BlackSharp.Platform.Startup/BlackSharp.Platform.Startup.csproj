<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net472;net481;netstandard2.0;net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Description>Cross-platform startup services for applications.</Description>
    <Copyright>Florian K.</Copyright>
    <PackageProjectUrl>https://github.com/Blacktempel/BlackSharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Blacktempel/BlackSharp</RepositoryUrl>
    <PackageTags>startup;autostart;boot;login;systemd;desktop-autostart;task-scheduler;process-privileges;administrator;windows;linux;cross-platform</PackageTags>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <Version>$(BlackSharpVersion)</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>BlackSharp.png</PackageIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)'=='net11.0'">
    <Features>$(Features);runtime-async=on</Features>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TaskScheduler" Version="2.12.2" />
    <ProjectReference Include="..\BlackSharp.Core\BlackSharp.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Assets\BlackSharp.png" Pack="true" PackagePath="\" />
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
