<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
	<LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Description>Reusable MVVM foundations for .NET applications.</Description>
    <Copyright>Florian K.</Copyright>
    <PackageProjectUrl>https://github.com/Blacktempel/BlackSharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Blacktempel/BlackSharp</RepositoryUrl>
    <PackageTags>mvvm;viewmodel;observable;propertychanged;databinding;communitytoolkit;dialogs;dragdrop;reordering;theming;dotnet</PackageTags>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <Version>$(BlackSharpVersion)</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>BlackSharp.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlackSharp.Core\BlackSharp.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Assets\BlackSharp.png" Pack="true" PackagePath="\" />
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
